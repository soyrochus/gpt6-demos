{
  "name": "dipper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "preview": "bun --bun vite preview",
    "build": "tsc --noEmit && bun --bun vite build",
    "test": "bun test",
    "test:e2e": "bun run build && bun --bun playwright test",
