    "catalog:validate": "bun scripts/validate.ts",
    "catalog:gaia": "bun scripts/build-gaia.ts"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19",
    "leaflet": "1.9.4",
    "luxon": "3.7.2",
    "@photostructure/tz-lookup": "11.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "lucide-react": "1.76.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/three": "0.187.0",
    "@types/leaflet": "1.9.22",
    "@types/luxon": "3.7.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@playwright/test": "1.65.1",
    "typescript": "7.0.2",
    "csv-parse": "7.0.3",
    "vite": "8.3.8"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
