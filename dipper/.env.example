# Optional public client settings. Astronomy and catalogue data run offline.
VITE_DEFAULT_LAT=39.4699
VITE_DEFAULT_LON=-0.3763
VITE_DEFAULT_ELEVATION_M=0
VITE_DEFAULT_TIME_ZONE=Europe/Madrid
# Provider for the optional online street detail layer.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
