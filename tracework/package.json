{
  "name": "tracework",
  "version": "1.0.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@openai/agents": "0.22.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cheerio": "1.2.0",
    "csv-parse": "7.0.3",
    "fflate": "0.8.3",
    "lucide-react": "1.75.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun run typecheck && bun --bun node_modules/vite/bin/vite.js build",
    "start": "bun apps/server/src/index.ts",
    "typecheck": "bun --bun node_modules/typescript/bin/tsc --noEmit",
    "test:e2e": "bun --bun node_modules/@playwright/test/cli.js test",
    "test:live": "bun scripts/live.ts",
    "test:execution": "bun scripts/execution-check.ts",
    "demo:seed": "bun scripts/demo.ts seed",
    "demo:reset": "bun scripts/demo.ts reset",
    "execution:prepare": "bun scripts/prepare-execution.ts",
    "benchmark": "bun scripts/benchmark.ts"
  }
}
